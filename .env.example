# Top-level .env for the WhisperLiveKit service.
# TranslateGemma has its own .env under translate-gemma/.env — this file does
# NOT control translategemma.

# ---------------------------------------------------------------------------
# GPU / runtime
# ---------------------------------------------------------------------------

WLK_CUDA_VISIBLE_DEVICES=0
WLK_PORT=8000

# ---------------------------------------------------------------------------
# HuggingFace cache
# ---------------------------------------------------------------------------

# Host directory used as the shared HF hub cache
HF_CACHE_DIR=~/.cache/huggingface

# Container-side path to the cool-whisper snapshot directory
COOL_WHISPER_SNAPSHOT_DIR=/root/.cache/huggingface/hub/models--andybi7676--cool-whisper-hf/snapshots/c0483435cc82205ba4be31c8bee60a71138cb639

# ---------------------------------------------------------------------------
# whisperlivekit-server flags
# ---------------------------------------------------------------------------

WLK_MODEL_PATH=models/cool-whisper
WLK_VAC_BACKEND=ten-vad
WLK_LANGUAGE=zh
WLK_TRANSLATION_MODEL=translategemma
WLK_TRANSLATION_MODEL_SIZE=4b

WLK_TRANSLATEGEMMA_URL=https://translategemma:8000/v1

# API key used by WhisperLiveKit when calling TranslateGemma (vLLM).
VLLM_API_KEY=

# Internal TranslateGemma HTTPS uses the local self-signed ssl-config cert by default.
TRANSLATEGEMMA_SSL_VERIFY=false

# Target translation language, e.g. --target-language en
WLK_TARGET_LANGUAGE_ARG=

# Enable SaT-based sentence boundary detection, e.g. --sentence-detection
WLK_SENTENCE_DETECTION_FLAG=

# IP allowlist, e.g. --allowed-ips 192.168.1.100,10.0.0.50
WLK_ALLOWED_IPS_ARG=

# Network (CIDR) allowlist, e.g. --allowed-networks 172.16.0.0/12
WLK_ALLOWED_NETWORKS_ARG=

# SSL certs (both flags must be set together), e.g.
#   WLK_SSL_ARGS=--ssl-certfile ssl-config/cert.pem --ssl-keyfile ssl-config/key.pem
WLK_SSL_ARGS=

# Optional flags
WLK_OPTIONAL_FLAGS=

# ---------------------------------------------------------------------------
# Embedded monitor client
# ---------------------------------------------------------------------------

# The WhisperLiveKit container now starts the monitor client internally.
WLK_MONITOR_ENABLED=true

# Must match monitor_service -> MONITOR_SECRET_KEY.
MONITOR_SECRET_KEY=

# URL of the monitor_service /update endpoint.
MONITOR_URL=

WLK_MONITOR_SERVICE_NAME=WhisperLiveKit