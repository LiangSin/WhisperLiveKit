# HuggingFace token used to download the model on first launch.
# Required for first-time model download (left empty if model is already cached).
HF_TOKEN=

# API key required by vLLM OpenAI-compatible endpoint.
VLLM_API_KEY=

# Model size: 4b, 12b, or 27b.
MODEL_SIZE=4b

# Host port the OpenAI-compatible API is exposed on.
# WhisperLiveKit clients should be pointed at https://<host>:${PORT}/v1
PORT=8765

# TLS certificate and private key used by the vLLM HTTPS endpoint.
SSL_CONFIG_DIR=../ssl-config

# GPU(s) the container is allowed to use. 
CUDA_VISIBLE_DEVICES=0

# vLLM tuning knobs — sane defaults are already provided in the compose file.
MAX_MODEL_LEN=512
GPU_MEMORY_UTILIZATION=0.85
MAX_NUM_SEQS=128

# Where the model weights are cached on the host.
HF_CACHE_DIR=~/.cache/huggingface

# ---------------------------------------------------------------------------
# Embedded monitor client
# ---------------------------------------------------------------------------

# The TranslateGemma container now starts the monitor client internally.
TG_MONITOR_ENABLED=true

# Must match monitor_service -> MONITOR_SECRET_KEY.
MONITOR_SECRET_KEY=

# URL of the monitor_service /update endpoint.
MONITOR_URL=

TG_MONITOR_SERVICE_NAME=TranslateGemma
